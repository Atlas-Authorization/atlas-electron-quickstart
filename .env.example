# Atlas + Electron quickstart. Export these before `npm start`, or edit
# src/config.js directly (Electron's main process reads process.env).

# Publishable key (used by the native session manager + renderer client).
ATLAS_PUBLISHABLE_KEY=pk_test_xxx

# The instance's Frontend API origin.
ATLAS_FRONTEND_API=https://atlasauth.net

# The first-party OAuth client id used for the token exchange.
ATLAS_OAUTH_CLIENT_ID=client_xxx
